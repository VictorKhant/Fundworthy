# Copy to .env for local runs. NEVER commit .env — it is in .gitignore. (CLAUDE.md §5)
# In production these are GitHub Actions Secrets, not a file. Mauri never sees any of this.

# --- Anthropic ---------------------------------------------------------------
# PLACEHOLDER. Replace with the real key.
# TODO(§11 Q6): nobody owns this key yet. Whoever does also owns the ~$2/month bill.
# Until it is set, `python -m agent.run` runs the free tiers only and says so.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# --- Google Sheets -----------------------------------------------------------
# The id from the Sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
RISE_SHEET_ID=REPLACE-ME

# Path to the service-account JSON. Mauri's only setup step is clicking Share on
# the Sheet and pasting in this account's email address (§4).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Behavior ----------------------------------------------------------------
# Set to 1 in CI. Makes an unreadable Config tab a hard failure instead of a
# silent fall back to defaults — otherwise a transient Sheets outage would run the
# agent with ENABLED defaulted to true, ignoring Mauri's kill switch.
RISE_STRICT_CONFIG=0
