# The public address this deployment is served from, with no trailing slash.
#
# Vite substitutes it into index.html at build time for the canonical link and the share
# cards, and into robots.txt / sitemap.xml by scripts/seo-urls.mjs. It is a build input
# rather than a committed constant so the hostname is not baked into a public repository,
# and so a second deployment does not advertise the first one's canonical URL.
#
# Set it on the VM before `npm run build` — scripts/deploy.sh reads it from ../.env:
#   VITE_SITE_URL=https://your-host.example.org
VITE_SITE_URL=https://fundworthy.example.org
