# secrets — never commit a key (CLAUDE.md §5)
.env
*.json.key
service-account*.json
credentials.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# run output
out/
*.jsonl
!evidence/**/*.jsonl
# generated each run; the scheduled job will commit it later
dashboard/public/run.json

# os
.DS_Store

# local control surface — the database and its encryption key never leave the machine
data/
*.db
*.db-wal
*.db-shm
.fernet-key

# the handoff PDF is a build artifact of docs/handoff/guide.html — but we DO commit it,
# because the person who needs it cannot run a build. (No ignore rule; noted here so
# nobody adds one.)
